# Copy to .env; never commit the resulting file. Values below are placeholders.
PORT=4000
HOST=0.0.0.0

# Local Docker PostgreSQL/PostGIS. Generate a local password and URL-encode it.
POSTGRES_USER=venuevista
POSTGRES_PASSWORD=replace-with-a-generated-local-password
POSTGRES_DB=venuevista
POSTGRES_PORT=5433
DATABASE_URL=postgresql://venuevista:replace-with-a-generated-local-password@127.0.0.1:5433/venuevista?schema=public
# Tests must use an isolated disposable database. Never point this at production.
TEST_DATABASE_URL=postgresql://venuevista:replace-with-a-generated-local-password@127.0.0.1:5433/venuevista_test?schema=public
ENABLE_INTEGRATION_TESTS=false

# Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ENABLE_DEV_AUTH=false
# Explicit local-only persona buttons; turn all four flags off outside development.
ADMIN_ENABLE_DEV_AUTH=false
EXPO_PUBLIC_ENABLE_DEV_AUTH=false

# Server-only Next.js API URL. Public Expo URL must be reachable from the phone.
API_URL=http://127.0.0.1:4000/api/v1
# Production admin requires its exact external HTTPS origin; never wildcard it.
# ADMIN_ORIGIN=https://admin.example.com
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082

# Server-only Firebase Admin application-default credentials; do not paste JSON here.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json
# FIREBASE_PROJECT_ID=

# Firebase web configuration is public, but never place Admin private keys in Expo.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=

# Local-development media storage only. Use a private external path for persisted uploads.
MEDIA_STORAGE_PATH=/tmp/venuevista-uploads
PUBLIC_API_URL=http://localhost:4000

# Optional storage overlay; see infrastructure/docker/README.md.
# Set separately before enabling MinIO. Never reuse production storage credentials.
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# MEDIA_STORAGE_DRIVER=s3
# S3_ALLOW_INSECURE_LOCAL=true # loopback development only; never production
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Configure only after the corresponding integration is implemented and verified.
# GOOGLE_MAPS_API_KEY=
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_DSN=


# Public Firebase web/mobile configuration (not Admin service credentials).
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Native mobile builds only: private local path to Google application configuration.
# GOOGLE_SERVICES_JSON=/absolute/path/to/google-services.json
# GOOGLE_SERVICES_PLIST=/absolute/path/to/GoogleService-Info.plist
