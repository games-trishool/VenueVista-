{
  "name": "venuevista",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev --parallel",
    "build": "dotenv -e .env -- turbo run build --concurrency=2",
    "typecheck": "turbo run typecheck --concurrency=2",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "dotenv -e .env -- turbo run test",
    "db:generate": "pnpm --filter @venuevista/api db:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @venuevista/api db:migrate",
    "db:seed": "dotenv -e .env -- pnpm --filter @venuevista/api db:seed",
    "db:up": "docker compose --env-file .env -f infrastructure/docker/compose.yaml up -d --wait db",
    "db:down": "docker compose --env-file .env -f infrastructure/docker/compose.yaml down",
    "dev:api": "dotenv -e .env -- pnpm --filter @venuevista/api dev",
    "dev:admin": "dotenv -e .env -- pnpm --filter @venuevista/admin-web dev",
    "dev:customer": "dotenv -e .env -- pnpm --filter @venuevista/customer-mobile dev",
    "dev:partner": "dotenv -e .env -- pnpm --filter @venuevista/partner-mobile dev",
    "setup:local": "node scripts/init-local.mjs && pnpm db:up && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "test:e2e": "dotenv -e .env -- playwright test",
    "db:test:prepare": "dotenv -e .env -- node scripts/prepare-test-db.mjs",
    "test:integration": "pnpm db:test:prepare && dotenv -e .env -- env ENABLE_INTEGRATION_TESTS=true turbo run test",
    "build:api-image": "node scripts/build-api-image.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.1",
    "turbo": "^2.6.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "@playwright/test": "^1.56.1"
  }
}
