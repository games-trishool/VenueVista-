# For an Android emulator use http://10.0.2.2:4000/api/v1.
# A physical device must reach your computer's LAN address; production requires HTTPS.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
# Development-only persona login. Never enable in a store release.
EXPO_PUBLIC_ENABLE_DEV_AUTH=false

# Public Firebase web application identifiers. No server credentials belong here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Native service configuration file paths, supplied during EAS/prebuild.
# Keep service files outside the checkout or use secure EAS file variables.
# GOOGLE_SERVICES_JSON=/absolute/path/to/customer-google-services.json
# GOOGLE_SERVICES_PLIST=/absolute/path/to/customer-GoogleService-Info.plist
