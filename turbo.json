{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "AUTH_JWT_SECRET",
    "ENABLE_DEV_AUTH",
    "ADMIN_ENABLE_DEV_AUTH",
    "API_URL",
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_ENABLE_DEV_AUTH",
    "FIREBASE_PROJECT_ID",
    "NEXT_PUBLIC_FIREBASE_API_KEY",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID",
    "ENABLE_INTEGRATION_TESTS",
    "MEDIA_STORAGE_PATH",
    "PUBLIC_API_URL",
    "CORS_ORIGINS",
    "HOST",
    "PORT",
    "GOOGLE_APPLICATION_CREDENTIALS",
    "EXPO_PUBLIC_*",
    "NEXT_PUBLIC_FIREBASE_*",
    "ADMIN_ORIGIN",
    "MEDIA_STORAGE_DRIVER",
    "S3_*",
    "AWS_*",
    "ENABLE_STORAGE_INTEGRATION_TESTS",
    "STORAGE_TEST_SERVICE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "CI",
    "XDG_CACHE_HOME",
    "XDG_DATA_HOME",
    "pnpm_config_store_dir",
    "npm_config_cache",
    "DOCKER_CONFIG"
  ]
}
